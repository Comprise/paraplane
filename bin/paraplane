#!/bin/sh
# Shim: picks the prebuilt binary in ../libexec for the current OS/arch.
# One uname call and POSIX parameter expansion only (no tr, no dirname): the
# shim runs on every hook, so every process it starts counts.
un=$(uname -sm 2>/dev/null)
os=${un% *}
arch=${un#* }
ext=
case "$os" in
  Linux*) os=linux ;;
  Darwin*) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows; ext=.exe ;;
esac
case "$arch" in
  x86_64|amd64) arch=amd64 ;;
  aarch64|arm64) arch=arm64 ;;
esac
case "$0" in
  */*) here=${0%/*} ;;
  *) here=. ;;
esac
bin="$here/../libexec/paraplane-$os-$arch$ext"
case "$os/$arch" in
  linux/amd64|linux/arm64|darwin/amd64|darwin/arm64|windows/amd64|windows/arm64)
    supported=1
    if [ -e "$bin" ]; then problem="is not executable"; else problem="was not found"; fi ;;
  *)
    supported=
    problem="is not built for this platform (supported: linux, darwin, windows on amd64/arm64)" ;;
esac
# project_root: like the binary, the nearest dir up from the project dir with
# .git or .paraplane/config.yaml (never climbing into $HOME from below it);
# without a marker, the project dir itself.
project_root() {
  start=${CLAUDE_PROJECT_DIR:-$PWD}
  cur=$start
  while :; do
    if [ -n "$HOME" ] && [ "$cur" = "$HOME" ] && [ "$cur" != "$start" ]; then break; fi
    if [ -e "$cur/.git" ] || [ -e "$cur/.paraplane/config.yaml" ]; then
      printf '%s\n' "$cur"
      return
    fi
    [ "$cur" = / ] && break
    parent=${cur%/*}
    [ -n "$parent" ] || parent=/
    [ "$parent" = "$cur" ] && break
    cur=$parent
  done
  printf '%s\n' "$start"
}
if [ ! -x "$bin" ]; then
  # Hooks must never fail the session.
  if [ "$1" = hook ]; then
    # Say why nothing happens, once per session, unless the project disabled the plugin.
    if [ "$2" = session-start ] && ! grep -q '^enabled:[[:space:]]*false' "$(project_root)/.paraplane/config.yaml" 2>/dev/null; then
      if [ -n "$supported" ]; then
        text="paraplane: the binary for $os/$arch $problem ($bin), plan checks are off. Reinstall the plugin (it installs from the release branch)."
      else
        text="paraplane: $os/$arch $problem, plan checks are off."
      fi
      msg=$(printf '%s' "$text" | sed 's/\\/\\\\/g; s/"/\\"/g')
      printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart"}}\n' "$msg"
    fi
    exit 0
  fi
  if [ -n "$supported" ]; then
    echo "paraplane: binary for $os/$arch $problem: $bin" >&2
  else
    echo "paraplane: $os/$arch $problem" >&2
  fi
  exit 1
fi
if [ "$1" = hook ]; then
  # No exec: a crash the binary cannot recover from (a Go fatal error exits 2,
  # which Claude Code treats as blocking) must not block the prompt or the turn.
  # Buffered for every hook, so a crash prints nothing instead of a partial
  # answer (a truncated deny or context JSON).
  out=$("$bin" "$@")
  rc=$?
  [ "$rc" -eq 0 ] && [ -n "$out" ] && printf '%s\n' "$out"
  exit 0
fi
exec "$bin" "$@"
