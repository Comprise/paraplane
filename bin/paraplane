#!/bin/sh
# Shim: picks the prebuilt binary in ../libexec for the current OS/arch.
os=$(uname -s | tr 'A-Z' 'a-z')
ext=
case "$os" in
  mingw*|msys*|cygwin*) os=windows; ext=.exe ;;
  linux*) os=linux ;;
  darwin*) os=darwin ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  aarch64|arm64) arch=arm64 ;;
  *) arch=unknown ;;
esac
bin="$(dirname "$0")/../libexec/paraplane-$os-$arch$ext"
if [ -e "$bin" ]; then problem="is not executable"; else problem="was not found"; fi
if [ ! -x "$bin" ]; then
  # Hooks must never fail the session.
  if [ "$1" = hook ]; then
    # Say why nothing happens, once per session, unless the project disabled the plugin.
    if [ "$2" = session-start ] && ! grep -q '^enabled:[[:space:]]*false' "${CLAUDE_PROJECT_DIR:-.}/.paraplane/config.yaml" 2>/dev/null; then
      msg=$(printf '%s' "paraplane: the binary for $os/$arch $problem ($bin), plan checks are off. Reinstall the plugin (it installs from the release branch)." | sed 's/\\/\\\\/g; s/"/\\"/g')
      printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart"}}\n' "$msg"
    fi
    exit 0
  fi
  echo "paraplane: binary for $os/$arch $problem: $bin" >&2
  exit 1
fi
if [ "$1" = hook ]; then
  # No exec: a crash the binary cannot recover from (a Go fatal error exits 2,
  # which Claude Code treats as blocking) must not block the prompt or the turn.
  if [ "$2" = session-start ]; then
    # Buffered, so a crash prints nothing instead of a partial answer.
    out=$("$bin" "$@")
    rc=$?
    [ "$rc" -eq 0 ] && [ -n "$out" ] && printf '%s\n' "$out"
  else
    "$bin" "$@"
  fi
  exit 0
fi
exec "$bin" "$@"
